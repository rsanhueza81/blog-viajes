---
import Base from '../../layouts/Base.astro';
import Mosaico from '../../components/Mosaico.astro';
import { imagenCompartir } from '../../lib/compartir';
import { cuantos, rangoViaje, viajesConRincones, type RinconConViaje, type Viaje } from '../../lib/datos';

export async function getStaticPaths() {
  const viajes = await viajesConRincones();
  return viajes.map(({ viaje, rincones }) => ({
    params: { viaje: viaje.id },
    props: { viaje, rincones },
  }));
}

const { viaje, rincones } = Astro.props as { viaje: Viaje; rincones: RinconConViaje[] };
const og = await imagenCompartir(rincones[rincones.length - 1].rincon.data.portada);
---

<Base tema="arena" imagen={og} titulo={viaje.data.titulo} descripcion={viaje.data.descripcion ?? `Rincones de ${viaje.data.titulo}`}>
  <div class="contenedor">
    <header class="cabeza">
      <h1 class="ancho">{viaje.data.titulo}</h1>
      <p class="meta">{rangoViaje(viaje)}, {cuantos(rincones.length)}</p>
      {viaje.data.descripcion && <p class="desc">{viaje.data.descripcion}</p>}
    </header>
    <Mosaico rincones={rincones} etiqueta={`Rincones de ${viaje.data.titulo}`} />
  </div>
</Base>

<style>
  .cabeza {
    padding-block: 3.5rem 3rem;
  }
  .cabeza h1 {
    font-size: clamp(2.75rem, 8vw, 7rem);
    line-height: 0.9;
  }
  .meta {
    margin: 1.25rem 0 0;
    color: var(--texto-suave);
    font-size: 1rem;
  }
  .desc {
    margin: 1rem 0 0;
    max-width: var(--ancho-texto);
    color: var(--texto-cuerpo);
  }
</style>
