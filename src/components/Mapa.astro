---
// Mapa del recorrido de un rincón: puntos numerados, la ruta en orden y la foto de cada lugar.
// Mapa abierto de OpenStreetMap (gratis, sin cuentas), oscurecido para calzar con el diseño.
// Cada lugar tiene su link "Ver en Google Maps".
import 'leaflet/dist/leaflet.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lugar } from '../lib/lugares';

interface Props {
  lugares: Lugar[];
  // Primera foto de cada lugar (por número), para mostrarla al tocar el punto.
  fotos: Map<number, { src: ImageMetadata; alt: string }>;
}

const { lugares, fotos } = Astro.props;
const datos = await Promise.all(
  lugares.map(async (l) => {
    const f = fotos.get(l.n);
    const mini = f ? await getImage({ src: f.src, width: 480, format: 'webp' }) : undefined;
    return { ...l, foto: mini?.src ?? null, alt: f?.alt ?? '' };
  })
);
---

{
  lugares.length > 0 && (
    <section class="recorrido" aria-labelledby="t-recorrido">
      <h2 id="t-recorrido" class="semiancho">El recorrido</h2>
      <div class="recorrido__cuerpo">
        <div class="mapa" data-lugares={JSON.stringify(datos)} role="region" aria-label="Mapa de los lugares del rincón" />
        <ol class="lugares">
          {datos.map((l) => (
            <li>
              <button type="button" class="lugar" data-n={l.n}>
                <span class="numero" aria-hidden="true">{l.n}</span>
                <span class="lugar__nombre">{l.nombre}</span>
              </button>
              <a class="lugar__google" href={l.google} target="_blank" rel="noopener">
                Ver en Google Maps
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )
}

<script>
  type LugarMapa = { n: number; nombre: string; lat: number; lon: number; google: string; foto: string | null; alt: string };

  const escapar = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  async function armar(seccion: HTMLElement) {
    const caja = seccion.querySelector<HTMLElement>('.mapa');
    if (!caja || caja.dataset.listo) return;
    caja.dataset.listo = '1';
    const lugares: LugarMapa[] = JSON.parse(caja.dataset.lugares || '[]');
    const L = (await import('leaflet')).default;

    const mapa = L.map(caja, {
      scrollWheelZoom: false,
      attributionControl: false,
      // En el celular, un dedo hace scroll en la página; el mapa se mueve con los botones o pellizcando.
      dragging: !L.Browser.mobile,
    });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(mapa);
    L.control.attribution({ prefix: '<a href="https://leafletjs.com">Leaflet</a>' }).addTo(mapa);

    const puntos = lugares.map((l) => [l.lat, l.lon] as [number, number]);
    if (puntos.length > 1) {
      L.polyline(puntos, { color: '#ece8e1', weight: 2, opacity: 0.75, dashArray: '4 7' }).addTo(mapa);
    }

    const marcadores = new Map<number, ReturnType<typeof L.marker>>();
    lugares.forEach((l) => {
      const icono = L.divIcon({
        className: 'marcador',
        html: `<span>${l.n}</span>`,
        iconSize: [30, 30],
        iconAnchor: [15, 15],
        popupAnchor: [0, -16],
      });
      const foto = l.foto ? `<img src="${l.foto}" alt="${escapar(l.alt)}" width="240" />` : '';
      const popup = `${foto}<strong>${l.n}. ${escapar(l.nombre)}</strong><a href="${l.google}" target="_blank" rel="noopener">Ver en Google Maps</a>`;
      const m = L.marker([l.lat, l.lon], { icon: icono, title: `${l.n}. ${l.nombre}` })
        .bindPopup(popup, { className: 'globo', maxWidth: 260 })
        .addTo(mapa);
      marcadores.set(l.n, m);
    });

    if (puntos.length === 1) mapa.setView(puntos[0], 11);
    else mapa.fitBounds(L.latLngBounds(puntos), { padding: [36, 36] });

    seccion.querySelectorAll<HTMLButtonElement>('button.lugar').forEach((b) =>
      b.addEventListener('click', () => {
        const m = marcadores.get(Number(b.dataset.n));
        if (!m) return;
        mapa.flyTo(m.getLatLng(), Math.max(mapa.getZoom(), 10), { duration: 0.6 });
        m.openPopup();
      })
    );
  }

  document.querySelectorAll<HTMLElement>('.recorrido').forEach((seccion) => {
    // El mapa se carga recién cuando está por aparecer en pantalla.
    const obs = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          obs.disconnect();
          armar(seccion);
        }
      },
      { rootMargin: '300px' }
    );
    obs.observe(seccion);
  });
</script>

<style>
  .recorrido {
    margin-bottom: 4.5rem;
  }
  .recorrido h2 {
    font-size: 1.75rem;
    margin-bottom: 1.25rem;
  }
  .recorrido__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    gap: 2rem;
    align-items: start;
  }
  .mapa {
    height: 28rem;
    background: var(--fondo-2);
    z-index: 0;
  }
  .lugares {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .lugares li {
    display: grid;
    gap: 0.125rem;
  }
  .lugar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.25rem 0;
    min-height: 44px;
    font: inherit;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--texto);
    background: none;
    border: 0;
    cursor: pointer;
    text-align: left;
  }
  .lugar:hover .lugar__nombre {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .lugar__google {
    margin-left: calc(30px + 0.75rem);
    font-size: 0.875rem;
    color: var(--texto-suave);
    text-underline-offset: 3px;
  }
  .lugar__google:hover {
    color: var(--texto);
  }
  .numero {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--texto);
    color: var(--fondo);
    font-size: 0.875rem;
    font-weight: 800;
  }

  /* Mapa oscuro: solo se oscurecen las teselas, no los puntos ni los globos */
  .mapa :global(.leaflet-tile-pane) {
    filter: invert(1) hue-rotate(180deg) brightness(0.95) contrast(0.9) saturate(0.6);
  }
  .mapa :global(.leaflet-container),
  .mapa:global(.leaflet-container) {
    background: #2b2a27;
    font-family: var(--fuente);
  }
  .mapa :global(.marcador) {
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--texto);
    color: var(--fondo);
    font-size: 0.875rem;
    font-weight: 800;
    border: 2px solid var(--fondo);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }
  .mapa :global(.globo .leaflet-popup-content-wrapper),
  .mapa :global(.globo .leaflet-popup-tip) {
    background: var(--fondo);
    color: var(--texto);
    border-radius: 2px;
  }
  .mapa :global(.globo .leaflet-popup-content) {
    margin: 10px;
    display: grid;
    gap: 6px;
    font-size: 0.9375rem;
    line-height: 1.3;
  }
  .mapa :global(.globo img) {
    width: 240px;
    height: auto;
    display: block;
  }
  .mapa :global(.globo a) {
    color: var(--texto-suave);
    font-size: 0.8125rem;
  }
  .mapa :global(.leaflet-popup-close-button) {
    color: var(--texto) !important;
  }
  .mapa :global(.leaflet-control-attribution) {
    background: rgba(34, 33, 31, 0.8);
    color: var(--texto-suave);
  }
  .mapa :global(.leaflet-control-attribution a) {
    color: var(--texto);
  }
  .mapa :global(.leaflet-bar a) {
    background: var(--fondo);
    color: var(--texto);
    border-color: var(--regla);
  }

  @media (max-width: 48rem) {
    .recorrido__cuerpo {
      grid-template-columns: 1fr;
    }
    .mapa {
      height: 20rem;
    }
  }
</style>
