---
// Formulario para recibir un correo cuando se publica un rincón nuevo.
// Los correos los guarda y los envía Buttondown; el blog no guarda nada.
import { SITIO } from '../config';
const accion = SITIO.suscripcion ? `https://buttondown.com/api/emails/embed-subscribe/${SITIO.suscripcion}` : '';
---

{
  accion && (
    <section class="suscribir" aria-labelledby="t-suscribir">
      <div class="contenedor suscribir__fila">
        <div>
          <h2 id="t-suscribir" class="semiancho">Avísame cuando haya un rincón nuevo</h2>
          <p>Un correo cada vez que publico uno. Nada más, y te puedes salir cuando quieras.</p>
        </div>
        <form action={accion} method="post" target="_blank">
          <label for="correo-suscribir">Tu correo</label>
          <div class="suscribir__campo">
            <input id="correo-suscribir" type="email" name="email" autocomplete="email" placeholder="nombre@correo.cl" required />
            <button type="submit">Suscribirme</button>
          </div>
        </form>
      </div>
    </section>
  )
}

<style>
  .suscribir {
    margin-top: 7rem;
    border-top: 1px solid var(--regla);
  }
  .suscribir__fila {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
    padding-block: 3rem 0;
  }
  h2 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.1;
  }
  p {
    margin: 0.75rem 0 0;
    max-width: 34ch;
    color: var(--texto-suave);
  }
  label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--texto-suave);
  }
  .suscribir__campo {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 0.75rem 0.875rem;
    font: inherit;
    font-size: 1rem;
    color: var(--texto);
    background: var(--fondo-2);
    border: 1px solid var(--regla);
    border-radius: 0.25rem;
  }
  input::placeholder {
    color: var(--texto-suave);
    opacity: 0.8;
  }
  button {
    padding: 0.75rem 1.25rem;
    font: inherit;
    font-size: 1rem;
    font-weight: 600;
    color: var(--fondo);
    background: var(--acento);
    border: 0;
    border-radius: 0.25rem;
    cursor: pointer;
  }
  button:hover {
    filter: brightness(1.08);
  }
  @media (max-width: 720px) {
    .suscribir__fila {
      grid-template-columns: 1fr;
    }
    .suscribir__campo {
      flex-direction: column;
    }
  }
</style>
