---
// Formulario para recibir un correo cuando se publica un rincón nuevo.
// Los correos los guarda y los envía Buttondown; el blog no guarda nada.
import { SITIO } from '../config';
const accion = SITIO.suscripcion ? `https://buttondown.com/api/emails/embed-subscribe/${SITIO.suscripcion}` : '';
---

{
  accion && (
    <section class="suscribir" aria-labelledby="t-suscribir">
      <div class="contenedor suscribir__fila">
        <div>
          <h2 id="t-suscribir" class="semiancho">Avísame cuando haya un rincón nuevo</h2>
          <p>Un correo por cada rincón que publico. Nada más.</p>
        </div>
        <form action={accion} method="post" target="_blank">
          <label class="oculto" for="correo-suscribir">Tu correo</label>
          <div class="suscribir__campo">
            <input id="correo-suscribir" type="email" name="email" autocomplete="email" placeholder="Tu correo" required />
            <button type="submit">Suscribirme</button>
          </div>
        </form>
      </div>
    </section>
  )
}

<style>
  .suscribir {
    margin-top: 7rem;
    border-top: 1px solid var(--regla);
  }
  .suscribir__fila {
    display: grid;
    grid-template-columns: 1fr minmax(0, 26rem);
    gap: 1rem 4rem;
    align-items: center;
    padding-block: 2rem 0;
  }
  h2 {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.2;
  }
  p {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }
  .oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .suscribir__campo {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    font: inherit;
    font-size: 1rem;
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--regla);
    border-radius: 0.25rem;
  }
  input::placeholder {
    color: var(--texto-suave);
  }
  button {
    padding: 0.5rem 0.875rem;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--acento);
    background: transparent;
    border: 1px solid var(--acento);
    border-radius: 0.25rem;
    cursor: pointer;
  }
  button:hover {
    color: var(--fondo);
    background: var(--acento);
  }
  @media (max-width: 720px) {
    .suscribir__fila {
      grid-template-columns: 1fr;
    }
  }
</style>
