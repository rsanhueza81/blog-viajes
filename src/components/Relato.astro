---
// Texto del rincón con las fotos intercaladas en distintos tamaños.
import { Image, getImage } from 'astro:assets';
import { armarTramos, type Foto } from '../lib/relato';

interface Props {
  html: string;
  fotos: Foto[];
  nombre: string;
}

const { html, fotos, nombre } = Astro.props;
const tramos = armarTramos(html, fotos);
const grandes = await Promise.all(
  fotos.map((f) => getImage({ src: f.src, width: Math.min(2200, f.src.width), format: 'webp' }))
);
const alt = (f: Foto, n: number) => f.pie ?? `Foto ${n + 1} de ${nombre}`;
const tamanos = {
  ancha: { widths: [800, 1200, 1600], sizes: '(max-width: 64rem) 100vw, 64rem' },
  lado: { widths: [500, 800, 1100], sizes: '(max-width: 48rem) 100vw, 36rem' },
  columna: { widths: [500, 800, 1100], sizes: '(max-width: 48rem) 100vw, 40rem' },
  par: { widths: [500, 800, 1100], sizes: '(max-width: 48rem) 100vw, 32rem' },
};
---

<div class="relato">
  {
    tramos.map((t, i) => (
      <section class:list={['tramo', t.grupo && `tramo--${t.grupo.tipo}`]}>
        {t.html && <div class:list={['prosa', { 'prosa--inicio': i === 0 }]} set:html={t.html} />}
        {t.grupo && (
          <div class="fotos">
            {t.grupo.fotos.map(({ foto, n }) => (
              <figure>
                <a href={grandes[n].src} data-grande={grandes[n].src} data-pie={foto.pie ?? ''}>
                  <Image
                    src={foto.src}
                    alt={alt(foto, n)}
                    widths={tamanos[t.grupo!.tipo].widths}
                    sizes={tamanos[t.grupo!.tipo].sizes}
                    loading="lazy"
                  />
                </a>
                {foto.pie && <figcaption>{foto.pie}</figcaption>}
              </figure>
            ))}
          </div>
        )}
      </section>
    ))
  }
  {
    fotos.length > 0 && (
      <dialog class="visor" aria-label="Foto ampliada">
        <figure>
          <img alt="" />
          <figcaption />
        </figure>
        <div class="visor__controles">
          <button type="button" data-accion="anterior">Anterior</button>
          <span class="visor__cuenta" />
          <button type="button" data-accion="siguiente">Siguiente</button>
          <button type="button" data-accion="cerrar">Cerrar</button>
        </div>
      </dialog>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>('.relato').forEach((relato) => {
    const enlaces = [...relato.querySelectorAll<HTMLAnchorElement>('a[data-grande]')];
    const visor = relato.querySelector<HTMLDialogElement>('.visor');
    if (!visor || enlaces.length === 0) return;
    const img = visor.querySelector('img')!;
    const pie = visor.querySelector('figcaption')!;
    const cuenta = visor.querySelector<HTMLElement>('.visor__cuenta')!;
    let i = 0;
    const mostrar = (n: number) => {
      i = (n + enlaces.length) % enlaces.length;
      const a = enlaces[i];
      img.src = a.dataset.grande!;
      img.alt = a.querySelector('img')?.alt ?? '';
      pie.textContent = a.dataset.pie ?? '';
      cuenta.textContent = `${i + 1} de ${enlaces.length}`;
    };
    enlaces.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        mostrar(n);
        visor.showModal();
      })
    );
    visor.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const accion = t.closest<HTMLElement>('[data-accion]')?.dataset.accion;
      if (accion === 'anterior') mostrar(i - 1);
      else if (accion === 'siguiente') mostrar(i + 1);
      else if (accion === 'cerrar' || t === visor) visor.close();
    });
    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(i - 1);
      if (e.key === 'ArrowRight') mostrar(i + 1);
    });
  });
</script>

<style>
  .tramo + .tramo {
    margin-top: 4rem;
  }
  /* Después de una foto al lado, el texto sigue con el espacio normal entre párrafos */
  .tramo--lado + .tramo {
    margin-top: 1.4rem;
  }
  /* El espacio entre tramos ya separa; un subtítulo al inicio no suma más aire */
  .tramo :global(.prosa > :first-child) {
    margin-top: 0;
  }
  figure {
    margin: 0;
  }
  .fotos a {
    display: block;
    cursor: zoom-in;
    background: var(--fondo-2);
  }
  .fotos img {
    width: 100%;
  }
  figcaption {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    line-height: 1.5;
    font-style: italic;
    color: var(--texto-suave);
  }

  /* Foto ancha: más que el texto, sin llegar a los bordes */
  .tramo--ancha .fotos {
    margin-top: 3.5rem;
    max-width: 64rem;
  }
  .tramo--ancha img {
    max-height: 80vh;
    object-fit: cover;
  }

  /* Foto del ancho de la columna de texto */
  .tramo--columna .fotos {
    margin-top: 3rem;
    max-width: var(--ancho-texto);
  }

  /* Dos fotos lado a lado */
  .tramo--par .fotos {
    margin-top: 3.5rem;
    max-width: 64rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
  }
  .tramo--par img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* Foto al lado del texto */
  .tramo--lado {
    display: grid;
    grid-template-columns: minmax(0, var(--ancho-texto)) minmax(0, 32rem);
    gap: 4rem;
    align-items: start;
  }
  .tramo--lado .fotos {
    padding-top: 0.5rem;
  }
  .tramo--lado img {
    max-height: 85vh;
    object-fit: cover;
  }

  @media (max-width: 56rem) {
    .tramo--lado {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .tramo--lado .fotos {
      margin-top: 3rem;
      padding-top: 0;
    }
  }
  @media (max-width: 40rem) {
    .tramo--par .fotos {
      grid-template-columns: 1fr;
    }
  }

  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: #151413;
    color: var(--texto);
  }
  .visor[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .visor::backdrop {
    background: #151413;
  }
  .visor figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
    min-height: 0;
  }
  .visor img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
  }
  .visor figcaption {
    text-align: center;
    min-height: 1.5em;
    margin: 0;
  }
  .visor__controles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .visor button {
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--texto);
    background: transparent;
    border: 2px solid rgba(236, 232, 225, 0.45);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    cursor: pointer;
  }
  .visor button:hover {
    border-color: var(--texto);
  }
  .visor__cuenta {
    font-size: 0.875rem;
    min-width: 4.5rem;
    text-align: center;
    color: var(--texto-suave);
  }
</style>
