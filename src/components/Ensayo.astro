---
// Fotos del rincón, armadas solas según su orientación:
// horizontales a todo el ancho o de a dos, verticales de a dos o al lado de su pie.
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Foto = { src: ImageMetadata; pie?: string };
interface Props {
  fotos: Foto[];
  nombre: string;
}

const { fotos, nombre } = Astro.props;

const esVertical = (f: Foto) => f.src.height > f.src.width;
type Grupo = { tipo: 'completa' | 'par' | 'lado'; fotos: { foto: Foto; n: number }[] };
const grupos: Grupo[] = [];
for (let i = 0; i < fotos.length; ) {
  const f = fotos[i];
  const sig = fotos[i + 1];
  const anterior = grupos[grupos.length - 1];
  if (esVertical(f)) {
    if (sig && esVertical(sig)) {
      grupos.push({ tipo: 'par', fotos: [{ foto: f, n: i }, { foto: sig, n: i + 1 }] });
      i += 2;
    } else {
      grupos.push({ tipo: 'lado', fotos: [{ foto: f, n: i }] });
      i += 1;
    }
  } else if (anterior?.tipo === 'completa' && sig && !esVertical(sig)) {
    grupos.push({ tipo: 'par', fotos: [{ foto: f, n: i }, { foto: sig, n: i + 1 }] });
    i += 2;
  } else {
    grupos.push({ tipo: 'completa', fotos: [{ foto: f, n: i }] });
    i += 1;
  }
}

const grandes = await Promise.all(
  fotos.map((f) => getImage({ src: f.src, width: Math.min(2200, f.src.width), format: 'webp' }))
);
const alt = (f: Foto, n: number) => f.pie ?? `Foto ${n + 1} de ${nombre}`;
---

{
  fotos.length > 0 && (
    <section class="ensayo" aria-label={`Fotos de ${nombre}`}>
      {grupos.map((g) => (
        <div class:list={['grupo', `grupo--${g.tipo}`]}>
          {g.fotos.map(({ foto, n }) => (
            <figure>
              <a href={grandes[n].src} data-grande={grandes[n].src} data-pie={foto.pie ?? ''}>
                <Image
                  src={foto.src}
                  alt={alt(foto, n)}
                  widths={g.tipo === 'completa' ? [800, 1400, 2000] : [600, 900, 1300]}
                  sizes={g.tipo === 'completa' ? '(max-width: 85rem) 100vw, 85rem' : '(max-width: 48rem) 100vw, 50vw'}
                  loading="lazy"
                />
              </a>
              {foto.pie && g.tipo !== 'lado' && <figcaption>{foto.pie}</figcaption>}
            </figure>
          ))}
          {g.tipo === 'lado' && <p class="pie-lado">{g.fotos[0].foto.pie}</p>}
        </div>
      ))}
      <dialog class="visor" aria-label="Foto ampliada">
        <figure>
          <img alt="" />
          <figcaption />
        </figure>
        <div class="visor__controles">
          <button type="button" data-accion="anterior">Anterior</button>
          <span class="visor__cuenta" />
          <button type="button" data-accion="siguiente">Siguiente</button>
          <button type="button" data-accion="cerrar">Cerrar</button>
        </div>
      </dialog>
    </section>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('.ensayo').forEach((ensayo) => {
    const enlaces = [...ensayo.querySelectorAll<HTMLAnchorElement>('a[data-grande]')];
    const visor = ensayo.querySelector<HTMLDialogElement>('.visor');
    if (!visor || enlaces.length === 0) return;
    const img = visor.querySelector('img')!;
    const pie = visor.querySelector('figcaption')!;
    const cuenta = visor.querySelector<HTMLElement>('.visor__cuenta')!;
    let i = 0;
    const mostrar = (n: number) => {
      i = (n + enlaces.length) % enlaces.length;
      const a = enlaces[i];
      img.src = a.dataset.grande!;
      img.alt = a.querySelector('img')?.alt ?? '';
      pie.textContent = a.dataset.pie ?? '';
      cuenta.textContent = `${i + 1} de ${enlaces.length}`;
    };
    enlaces.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        mostrar(n);
        visor.showModal();
      })
    );
    visor.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const accion = t.closest<HTMLElement>('[data-accion]')?.dataset.accion;
      if (accion === 'anterior') mostrar(i - 1);
      else if (accion === 'siguiente') mostrar(i + 1);
      else if (accion === 'cerrar' || t === visor) visor.close();
    });
    visor.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') mostrar(i - 1);
      if (e.key === 'ArrowRight') mostrar(i + 1);
    });
  });
</script>

<style>
  .ensayo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4.5rem;
  }
  figure {
    margin: 0;
  }
  .grupo a {
    display: block;
    cursor: zoom-in;
    background: var(--fondo-2);
  }
  .grupo img {
    width: 100%;
    object-fit: cover;
  }
  .grupo--completa img {
    max-height: 85vh;
  }
  .grupo--par {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    align-items: start;
  }
  .grupo--par img {
    aspect-ratio: 4 / 5;
  }
  .grupo--lado {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 2.5rem;
    align-items: end;
    margin-block: 3.5rem;
  }
  .grupo--lado img {
    max-height: 90vh;
  }
  figcaption,
  .pie-lado {
    margin: 0.625rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--texto-suave);
    font-style: italic;
  }
  .pie-lado {
    font-size: 1.0625rem;
    margin: 0;
  }
  @media (max-width: 48rem) {
    .grupo--par,
    .grupo--lado {
      grid-template-columns: 1fr;
    }
    .grupo--lado {
      gap: 0.625rem;
      margin-block: 0;
    }
  }

  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: #151413;
    color: var(--texto);
  }
  .visor[open] {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
  }
  .visor::backdrop {
    background: #151413;
  }
  .visor figure {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 0.75rem;
    min-height: 0;
  }
  .visor img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    min-height: 0;
  }
  .visor figcaption {
    text-align: center;
    min-height: 1.5em;
    margin: 0;
  }
  .visor__controles {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .visor button {
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--texto);
    background: transparent;
    border: 2px solid rgba(236, 232, 225, 0.45);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    min-height: 44px;
    cursor: pointer;
  }
  .visor button:hover {
    border-color: var(--texto);
  }
  .visor__cuenta {
    font-size: 0.875rem;
    min-width: 4.5rem;
    text-align: center;
    color: var(--texto-suave);
  }
</style>
