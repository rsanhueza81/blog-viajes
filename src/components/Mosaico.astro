---
// Mosaico de rincones: el primero grande y los demás en un patrón que se repite.
import { Image } from 'astro:assets';
import { lugarYMes, urlRincon, type RinconConViaje } from '../lib/datos';

interface Props {
  rincones: RinconConViaje[];
  etiqueta?: string;
}

const { rincones, etiqueta = 'Rincones' } = Astro.props;

// Tamaños según cuántos rincones hay, para que el mosaico siempre quede completo
// (sin rellenar con otras fotos: solo se reparten mejor las que hay).
// Con 4 o más se alternan dos bloques que llenan filas enteras:
//   A (2 filas): grande, alta, normal, normal   B (1 fila): ancha, normal, normal
function tamanos(n: number): string[] {
  if (n === 1) return ['completa'];
  if (n === 2) return ['mitad', 'mitad'];
  if (n === 3) return ['grande', 'ancha', 'ancha'];
  const bloques = [
    ['grande', 'alta', '', ''],
    ['ancha', '', ''],
  ];
  const t: string[] = [];
  let b = 0;
  while (t.length < n) {
    const bloque = bloques[b % 2];
    const quedan = n - t.length;
    if (quedan >= bloque.length) t.push(...bloque);
    else if (quedan === 1) t.push('fila');
    else if (quedan === 2) t.push('ancha', 'ancha');
    else t.push('ancha', '', '');
    b++;
  }
  return t;
}
const patron = tamanos(rincones.length);
---

<ul class="mosaico" aria-label={etiqueta}>
  {
    rincones.map((item, i) => {
      const tamano = patron[i];
      const grande = ['grande', 'completa', 'mitad'].includes(tamano);
      return (
        <li class:list={['tile', tamano && `tile--${tamano}`]}>
          <a href={urlRincon(item.rincon)}>
            <Image
              src={item.rincon.data.portada}
              alt={item.rincon.data.portadaAlt}
              widths={tamano === 'completa' ? [800, 1400, 2000] : grande ? [700, 1100, 1600] : [500, 800, 1100]}
              sizes={tamano === 'completa' ? '(max-width: 85rem) 100vw, 85rem' : grande ? '(max-width: 48rem) 100vw, 50vw' : '(max-width: 48rem) 50vw, 25vw'}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
            <span class="tile__texto">
              <span class="tile__nombre semiancho">{item.rincon.data.nombre}</span>
              <span class="tile__lugar">{lugarYMes(item)}</span>
              <span class="tile__leer">Leer el rincón →</span>
            </span>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .mosaico {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-auto-rows: 17rem;
    grid-auto-flow: dense;
    gap: 10px;
  }
  .tile--completa {
    grid-column: span 4;
    grid-row: span 2;
  }
  .tile--mitad {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--fila {
    grid-column: span 4;
  }
  .tile--grande {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--alta {
    grid-row: span 2;
  }
  .tile--ancha {
    grid-column: span 2;
  }
  .tile a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    background: var(--fondo-2);
    /* el texto va sobre la foto: siempre claro, en cualquier tema */
    color: #f3efe8;
    text-decoration: none;
  }
  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .tile a:hover img {
    transform: scale(1.03);
  }
  .tile a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 19, 18, 0.8), rgba(20, 19, 18, 0) 55%);
  }
  .tile a:focus-visible {
    outline-offset: 3px;
  }
  .tile__texto {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.125rem;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .tile__nombre {
    font-size: 1.75rem;
    line-height: 1;
  }
  .tile--grande .tile__nombre,
  .tile--completa .tile__nombre,
  .tile--mitad .tile__nombre {
    font-size: clamp(2.25rem, 4.5vw, 4rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
  }
  .tile--ancha .tile__nombre,
  .tile--fila .tile__nombre {
    font-size: 2.5rem;
  }
  .tile--completa .tile__nombre {
    font-size: clamp(2.5rem, 6vw, 5.5rem);
  }
  .tile__lugar {
    font-size: 0.875rem;
    line-height: 1.3;
    color: #d6d0c5;
  }
  .tile__leer {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tile--grande .tile__lugar,
  .tile--completa .tile__lugar,
  .tile--mitad .tile__lugar {
    font-size: 0.9375rem;
  }
  @media (max-width: 48rem) {
    .mosaico {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-rows: 12.5rem;
    }
    .tile--completa,
    .tile--fila {
      grid-column: span 2;
    }
    .tile--mitad {
      grid-row: span 1;
    }
    .tile__nombre,
    .tile--ancha .tile__nombre {
      font-size: 1.375rem;
    }
    .tile__texto {
      left: 0.875rem;
      right: 0.875rem;
      bottom: 0.75rem;
    }
  }
</style>
