---
// Lista de viajes: nombre, fechas y una tira con las portadas de sus 4 rincones
// más recientes (el más nuevo primero). Solo fotos reales: no se rellenan huecos.
import { Image } from 'astro:assets';
import { cuantos, rangoViaje, urlViaje, type RinconConViaje, type Viaje } from '../lib/datos';

interface Props {
  viajes: { viaje: Viaje; rincones: RinconConViaje[] }[];
  nivel?: 'h2' | 'h3';
}

const { viajes, nivel = 'h3' } = Astro.props;
const Titulo = nivel;
---

<ul class="viajes">
  {
    viajes.map(({ viaje, rincones }) => (
      <li class="viaje">
        <div class="viaje__texto">
          <Titulo class="viaje__nombre semiancho">
            <a href={urlViaje(viaje)}>{viaje.data.titulo}</a>
          </Titulo>
          <p class="viaje__meta">
            {rangoViaje(viaje)}, {cuantos(rincones.length)}
          </p>
          {viaje.data.descripcion && <p class="viaje__desc">{viaje.data.descripcion}</p>}
          <p class="viaje__ver">
            <a href={urlViaje(viaje)}>Ver los rincones de este viaje →</a>
          </p>
        </div>
        <a class="tira" href={urlViaje(viaje)} tabindex="-1" aria-hidden="true">
          {[...rincones].reverse().slice(0, 4).map(({ rincon }) => (
            <Image src={rincon.data.portada} alt="" widths={[300, 500]} sizes="(max-width: 48rem) 25vw, 15vw" loading="lazy" />
          ))}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .viajes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .viaje {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 2rem;
    align-items: center;
  }
  .viaje__nombre {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.05;
  }
  .viaje__nombre a {
    text-decoration: none;
  }
  .viaje__nombre a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .viaje__meta {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    color: var(--texto-suave);
  }
  .viaje__desc {
    margin: 0.75rem 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--texto-cuerpo);
  }
  .viaje__ver {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .viaje__ver a {
    color: var(--acento);
    text-underline-offset: 4px;
  }
  .tira {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .tira img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--fondo-2);
  }
  @media (max-width: 48rem) {
    .viaje {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
